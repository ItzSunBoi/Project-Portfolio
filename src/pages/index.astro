---
import Hero from "../components/hero/Hero.astro";
import ProjectCard from "../components/projects/ProjectCard.astro";
import SectionHeading from "../components/common/SectionHeading.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { content, getVisibleProjects } from "../lib/content";

const projects = getVisibleProjects();
const featuredProjects = projects
  .filter((project) => project.featured)
  .slice(0, 6);
const projectById = new Map(projects.map((project) => [project.id, project]));

const homeJsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: content.site.name,
  url: content.site.baseUrl,
  description: content.site.description,
  knowsAbout: [
    "Embedded systems",
    "PCB design",
    "Robotics",
    "Computer vision",
    "Software development",
  ],
};
---

<BaseLayout jsonLd={homeJsonLd}>
  <Hero />

  <section class="section section-soft" aria-labelledby="featured-title">
    <div class="site-shell">
      <SectionHeading
        eyebrow="Selected work"
        title="Projects that cross the hardware–software boundary"
        description="A selection of systems, tools and experiments. Each starts with a practical problem and usually acquires a PCB somewhere along the way."
      />
      <div class="projects-grid">
        {featuredProjects.map((project) => <ProjectCard project={project} />)}
      </div>
      <div class="section-action">
        <a class="button button-secondary" href="/projects/">
          Browse all projects <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section" id="skills" aria-labelledby="skills-title">
    <div class="site-shell">
      <SectionHeading
        eyebrow="Skills & toolbox"
        title="A practical stack for making systems work"
        description="Grouped by the work they enable."
      />
      <div class="skills-grid">
        {
          content.skills.map((group) => (
            <article class="skill-group">
              <div class="skill-group-heading">
                <span class="skill-group-number">{group.code}</span>
                <h3>{group.title}</h3>
                <p>{group.description}</p>
              </div>
              <div class="skill-list" aria-label={`${group.title} skills`}>
                {group.skills.map((skill) => (
                  <span class="skill-pill">{skill}</span>
                ))}
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="exploration-title">
    <div class="site-shell">
      <SectionHeading
        eyebrow="Current exploration"
        title="The threads connecting current work"
        description="Recurring areas of investigation, linked back to the projects where they become concrete."
      />
      <div class="exploration-grid">
        {
          content.timeline.map((item) => (
            <article class="exploration-item">
              <span class="exploration-marker">{item.code}</span>
              <div>
                <h3>{item.title}</h3>
                <p>{item.description}</p>
                <div class="exploration-links">
                  {item.relatedProjects.slice(0, 2).map((projectId) => {
                    const project = projectById.get(projectId);
                    return project ? (
                      <a href={`/projects/${project.slug}/`}>
                        {project.title} →
                      </a>
                    ) : null;
                  })}
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section-soft">
    <div class="site-shell cta-band">
      <div>
        <p class="eyebrow">Find a project</p>
        <h2>Start with the system, then follow the decisions.</h2>
        <p>
          Explore the complete project index or see the tools I use to turn
          questionable ideas into measurable ones.
        </p>
      </div>
      <div class="hero-actions">
        <a class="button button-primary" href="/projects/">Explore projects</a>
        <a class="button button-secondary" href="/contact/">Contact</a>
      </div>
    </div>
  </section>
</BaseLayout>

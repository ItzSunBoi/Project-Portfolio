---
import SectionHeading from "../components/common/SectionHeading.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { content } from "../lib/content";

const profileLinks = content.socials.filter(
  (social) => social.visible && social.url,
);
---

<BaseLayout
  title="Contact"
  description="How to contact me about my hardware, embedded systems and software projects."
  canonicalPath="/contact/"
>
  <header class="site-shell page-header">
    <SectionHeading
      as="h1"
      eyebrow="Contact"
      title="If you know me, find me."
      description="Ooooh, you can't find mee!."
    />
  </header>

  <section class="section section-soft" style="padding-top: 3rem">
    <div class="site-shell contact-layout">
      <div class="contact-message">
        <p class="eyebrow">{content.contact.eyebrow}</p>
        <h2>{content.contact.title}</h2>
        <p>{content.contact.knownContact}</p>
        <p>
          {content.contact.inquiryPrefix}
          {" "}
          <a class="contact-email" href={`mailto:${content.contact.email}`}>
            {content.contact.email}
          </a>
        </p>
      </div>

      <aside class="contact-profiles">
        <p class="eyebrow">Profiles</p>
        <h2>{content.contact.profilesTitle}</h2>
        {
          profileLinks.length > 0 ? (
            <div class="contact-options">
              {profileLinks.map((link) => (
                <a class="contact-option" href={link.url} rel="me noreferrer">
                  <span>
                    <small>{link.label}</small>
                    <strong>{link.url.replace(/^https?:\/\//, "")}</strong>
                  </span>
                  <span aria-hidden="true">↗</span>
                </a>
              ))}
            </div>
          ) : (
            <p class="contact-empty">{content.contact.emptyProfilesMessage}</p>
          )
        }
      </aside>
    </div>
  </section>
</BaseLayout>

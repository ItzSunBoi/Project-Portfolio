---
import { formatProjectYear } from "../../lib/dates";
import { projectCategoryLabels } from "../../lib/project-taxonomy";
import type { Project } from "../../schemas/project";
import PhotoGallery from "../projects/PhotoGallery.astro";

interface Props {
  project: Project;
}

const { project } = Astro.props;
const images = project.content.flatMap((block) => {
  if (block.type === "image") return [block];
  if (block.type === "gallery") return block.images;
  return [];
});
const front = project.thumbnail &&
  project.thumbnailAlt && {
    src: project.thumbnail,
    alt: project.thumbnailAlt,
    caption: "The assembled console",
  };
const rear = images.find(({ src }) =>
  src.includes("/rear-coin-cell-blue-case-"),
);
const packaging = images.find(({ src }) =>
  src.includes("/packaging-and-accessories-"),
);
const photos = [
  ...(front ? [{ ...front, label: "Front" }] : []),
  ...(rear ? [{ ...rear, label: "Rear" }] : []),
  ...(packaging ? [{ ...packaging, label: "Packaging" }] : []),
];
const specRows = project.content.find(
  (block) => block.type === "specificationTable",
)?.rows;
const featureSpecs = ["Display", "Power"].flatMap(
  (label) => specRows?.find((row) => row.label === label) ?? [],
);
---

<article
  class:list={["feature-layout", { "feature-with-photos": photos.length > 0 }]}
>
  {
    photos.length > 0 && (
      <div class="feature-photos">
        <PhotoGallery
          photos={photos}
          label={`${project.title} photographs`}
          id={`feature-${project.id}`}
        />
      </div>
    )
  }
  <div class="feature-copy">
    <p class="feature-meta">
      {projectCategoryLabels[project.category]} · {
        formatProjectYear(project.year, project.yearEnd)
      }
    </p>
    <h3>{project.title}</h3>
    <p class="feature-lead">
      I built a complete game console that fits on a keyring.
    </p>
    {
      featureSpecs.length > 0 && (
        <dl class="feature-specs">
          {featureSpecs.map(({ label, value }) => (
            <div>
              <dt>{label}</dt>
              <dd>{value}</dd>
            </div>
          ))}
        </dl>
      )
    }
    <a class="button button-primary" href={`/projects/${project.slug}/`}>
      Read the build <span aria-hidden="true">→</span>
    </a>
  </div>
</article>

<style>
  .feature-layout {
    display: grid;
    border-bottom: 1px solid var(--border-strong);
  }

  .feature-with-photos {
    grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr);
    grid-template-areas: "photos copy";
    border-bottom: 0;
  }

  .feature-photos {
    display: grid;
    min-width: 0;
    grid-area: photos;
  }

  .feature-copy {
    --button-bg: var(--project-highlight-text);
    --button-text: var(--project-highlight);
    --focus: var(--project-highlight-text);
    display: flex;
    flex-direction: column;
    align-items: start;
    justify-content: center;
    min-width: 0;
    padding: clamp(1.45rem, 3.6vw, 4rem);
    background: var(--project-highlight);
    color: var(--project-highlight-text);
  }

  .feature-with-photos .feature-copy {
    grid-area: copy;
  }

  .feature-meta {
    margin: 0;
    font: 0.75rem var(--font-mono);
    letter-spacing: 0.055em;
    text-transform: uppercase;
  }

  h3 {
    margin: 0.17em 0 0.27em -0.037em;
    font-size: clamp(2.9rem, 7.05vw, 7.4rem);
    font-weight: 700;
    letter-spacing: -0.09em;
    line-height: 0.91;
  }

  .feature-lead {
    max-width: 23ch;
    margin: 0;
    font-size: clamp(1.1rem, 1.8vw, 1.6rem);
    letter-spacing: -0.027em;
    line-height: 1.3;
  }

  .feature-specs {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 0.75rem;
    width: 100%;
    margin-block: clamp(1rem, 2.1vw, 2rem);
    padding-top: 0.7rem;
    border-top: 1px solid color-mix(in srgb, currentColor 45%, transparent);
  }

  .feature-specs dt {
    margin-bottom: 0.3rem;
    font: 0.75rem var(--font-mono);
  }

  .feature-specs dd {
    margin: 0;
    font-weight: 700;
    line-height: 1.3;
  }

  .feature-copy .button {
    margin-top: 0.35rem;
  }

  :global(:root[data-design="workbench"]) .feature-with-photos {
    grid-template-areas: "copy photos";
    grid-template-columns: minmax(0, 0.88fr) minmax(0, 1.12fr);
  }

  :global(:root[data-design="workbench"]) .feature-copy {
    border-bottom: 1px solid var(--border-strong);
  }

  @media (max-width: 720px) {
    .feature-with-photos,
    :global(:root[data-design="workbench"]) .feature-with-photos {
      grid-template-columns: 1fr;
    }

    .feature-with-photos {
      grid-template-areas: "photos" "copy";
    }

    :global(:root[data-design="workbench"]) .feature-with-photos {
      grid-template-areas: "copy" "photos";
    }

    h3 {
      font-size: clamp(3.25rem, 11vw, 5.6rem);
    }
  }
</style>

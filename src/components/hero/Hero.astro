---
import { content } from "../../lib/content";
import HeroIllustration from "./HeroIllustration.astro";

const [givenName, ...otherNames] = content.site.name.split(" ");
---

<section class="home-hero site-shell" aria-labelledby="hero-title">
  <h1 id="hero-title">
    <span class="editorial">
      <span class="sr-only">I build hardware.</span>
      <span aria-hidden="true"
        >I build <span class="next-line"
          >hardware<span class="period">.</span></span
        ></span
      >
    </span>
    <span class="workbench">
      <span class="sr-only">{content.site.name}.</span>
      <span aria-hidden="true"
        >{givenName}{
          otherNames.length > 0 && (
            <span class="next-line"> {otherNames.join(" ")}</span>
          )
        }<span class="period">.</span></span
      >
    </span>
  </h1>
  <div class="hero-intro">
    <p class="editorial">
      I’m {content.site.name}. I design the boards, write the firmware and build
      the tools to put them together.
    </p>
    <p class="workbench">
      I build electronics, write firmware and make tools for the workshop.
    </p>
    <a class="button button-primary" href="/projects/">
      Explore projects <span aria-hidden="true">→</span>
    </a>
  </div>
  <div class="profiler">
    <HeroIllustration />
  </div>
</section>

<style>
  .home-hero {
    display: grid;
    grid-template-areas: "title profiler" "intro profiler";
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    grid-template-rows: 1fr 1fr;
    align-items: end;
    gap: 1.25rem clamp(1.6rem, 5vw, 7rem);
    padding-block: clamp(2.15rem, 4.3vw, 4.6rem) clamp(2rem, 4vw, 4.3rem);
  }

  h1 {
    grid-area: title;
    margin: 0 0 0 -0.045em;
    font-size: clamp(4rem, 11.35vw, 10.8rem);
    font-weight: 700;
    letter-spacing: -0.088em;
    line-height: 0.815;
  }

  .next-line::before {
    content: "";
    display: block;
  }

  .period {
    color: var(--primary-strong);
  }

  .hero-intro {
    grid-area: intro;
    align-self: start;
  }

  .hero-intro p {
    max-width: 30ch;
    margin: 0 0 clamp(0.95rem, 2vw, 1.4rem);
    font-size: clamp(1.05rem, 1.68vw, 1.55rem);
    letter-spacing: -0.025em;
    line-height: 1.4;
  }

  .profiler {
    grid-area: profiler;
    min-width: 0;
    max-width: 30rem;
    width: 100%;
    align-self: center;
    justify-self: end;
  }

  :global(:root:not([data-design="workbench"])) .workbench,
  :global(:root[data-design="workbench"]) .editorial {
    display: none;
  }

  :global(:root[data-design="workbench"]) .home-hero {
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.15fr);
    gap: 1.5rem clamp(1.65rem, 5vw, 5rem);
  }

  :global(:root[data-design="workbench"]) h1 {
    font-size: clamp(3.7rem, 8.85vw, 8.6rem);
  }

  :global(:root[data-design="workbench"]) .profiler {
    max-width: 35rem;
  }

  @media (max-width: 720px) {
    .home-hero,
    :global(:root[data-design="workbench"]) .home-hero {
      grid-template-areas: "title" "intro" "profiler";
      grid-template-columns: 1fr;
      grid-template-rows: auto;
      gap: 1.15rem;
      padding-block: 1.9rem 1.65rem;
    }

    h1 {
      font-size: clamp(3.5rem, 15.5vw, 7.5rem);
    }

    .hero-intro p {
      max-width: 34ch;
    }

    :global(:root[data-design="workbench"]) h1 {
      font-size: clamp(3.05rem, 13vw, 6rem);
    }

    .workbench .next-line::before {
      display: none;
    }

    .profiler {
      justify-self: center;
    }
  }
</style>

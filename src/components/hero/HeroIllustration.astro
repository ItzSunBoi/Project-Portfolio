<figure
  class="hero-visual"
  role="img"
  aria-labelledby="exploded-build-title"
  aria-describedby="exploded-build-description"
>
  <figcaption id="exploded-build-title" class="hero-visual-title">
    Dual Laser Surface Profiler
  </figcaption>

  <span id="exploded-build-description" class="sr-only">
    An exploded view of the custom PCB, top case, OV9281 camera sensor, dual
    line lasers and bottom case.
  </span>

  <img
    class="exploded-layer exploded-base"
    src="/images/hero/exploded-base.png"
    width="2048"
    height="2048"
    alt=""
    aria-hidden="true"
    fetchpriority="high"
  />
  <img
    class="exploded-layer exploded-labels exploded-labels-light"
    src="/images/hero/exploded-text-black.png"
    width="2048"
    height="2048"
    alt=""
    aria-hidden="true"
    fetchpriority="high"
  />
  <img
    class="exploded-layer exploded-labels exploded-labels-dark"
    src="/images/hero/exploded-text-white.png"
    width="2048"
    height="2048"
    alt=""
    aria-hidden="true"
    fetchpriority="high"
  />
</figure>

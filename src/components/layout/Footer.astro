---
import { content } from "../../lib/content";

const visibleSocials = content.socials.filter(
  (social) => social.visible && social.url,
);
const isContactPage = /^\/contact\/?$/.test(Astro.url.pathname);
const footerNavigation = content.navigation.filter(
  (item) => item.href !== "/contact/",
);
---

<footer class="site-footer" data-menu-background>
  <div class="site-shell footer-grid">
    {
      !isContactPage && (
        <div class="footer-intro">
          <a class="footer-contact" href="/contact/">
            Get in touch<span aria-hidden="true">.</span>
          </a>
          <p>{content.site.footerLine}</p>
        </div>
      )
    }
    <nav class="footer-links" aria-label="Footer navigation">
      {footerNavigation.map((item) => <a href={item.href}>{item.label}</a>)}
      {
        visibleSocials.map((social) => (
          <a href={social.url} rel="me noreferrer">
            {social.label} <span aria-hidden="true">↗</span>
          </a>
        ))
      }
      <a href={`mailto:${content.contact.email}`}>Email</a>
    </nav>
    <div class="footer-bottom">
      <p class="footer-attribution">
        <span>© 2026 Sun Zheng (ItzSunBoi)</span>
        <span>Built with Astro plus a sprinkle of AI.</span>
        <span>
          Ducks courtesy of <a href="https://random-d.uk/" rel="noreferrer">
            https://random-d.uk/
          </a>
        </span>
      </p>
      <a href="#top">Back to top <span aria-hidden="true">↑</span></a>
    </div>
  </div>
</footer>

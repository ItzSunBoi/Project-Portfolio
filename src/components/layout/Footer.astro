---
import { currentYear } from "../../lib/dates";
import { content } from "../../lib/content";
import SunMark from "../common/SunMark.astro";

const displayDomain = new URL(content.site.baseUrl).hostname;
const visibleSocials = content.socials.filter(
  (social) => social.visible && social.url,
);
---

<footer class="site-footer">
  <div class="site-shell footer-grid">
    <div class="footer-brand">
      <a
        class="brand-link"
        href="/"
        aria-label={`${content.site.brandName} home`}
      >
        <SunMark class="brand-sun" size={34} />
        <span class="brand-wordmark">
          <strong>{content.site.brandName}</strong>
          <small>{displayDomain}</small>
        </span>
      </a>
      <p>{content.site.footerLine}</p>
    </div>

    <div class="footer-links">
      <div>
        <h2>Navigate</h2>
        {
          content.navigation
            .slice(0, 4)
            .map((item) => <a href={item.href}>{item.label}</a>)
        }
      </div>
      <div>
        <h2>Elsewhere</h2>
        {
          visibleSocials.map((social) => (
            <a href={social.url} rel="me noreferrer">
              {social.label}
            </a>
          ))
        }
        <a href={`mailto:${content.contact.email}`}>Email</a>
      </div>
    </div>
  </div>
  <div class="site-shell footer-bottom">
    <p>
      {
        `© ${currentYear()} ${content.site.name}. Built with Astro and stubborn curiosity plus a bit of AI.`
      }
    </p>
    <a href="#top">Back to top <span aria-hidden="true">↑</span></a>
  </div>
</footer>

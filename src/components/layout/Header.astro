---
import { content } from "../../lib/content";
import SunMark from "../common/SunMark.astro";
import ThemeToggle from "../common/ThemeToggle.astro";

const pathname = Astro.url.pathname;
const displayDomain = new URL(content.site.baseUrl).hostname;

function isActive(href: string) {
  if (href.includes("#")) return false;
  if (href === "/") return pathname === "/";
  return pathname.startsWith(href);
}

function navigationTarget(href: string) {
  const target = new URL(href, content.site.baseUrl);

  return {
    pathname: target.pathname,
    hash: target.hash,
  };
}

const navigation = content.navigation.map((item) => ({
  ...item,
  ...navigationTarget(item.href),
  active: isActive(item.href),
}));
---

<header class="site-header" data-site-header>
  <div class="site-shell header-inner">
    <a
      class="brand-link"
      href="/"
      aria-label={`${content.site.brandName} home`}
    >
      <SunMark class="brand-sun" size={34} />
      <span class="brand-wordmark">
        <strong>{content.site.brandName}</strong>
        <small>{displayDomain}</small>
      </span>
    </a>

    <nav class="desktop-nav" aria-label="Primary navigation">
      {
        navigation.map((item) => (
          <a
            class:list={["nav-link", item.active && "is-active"]}
            href={item.href}
            aria-current={item.active ? "page" : undefined}
            data-nav-link
            data-nav-pathname={item.pathname}
            data-nav-hash={item.hash}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="header-actions">
      <ThemeToggle />
      <div class="mobile-menu" data-mobile-menu data-open="false">
        <button
          type="button"
          class="menu-toggle"
          aria-label="Open navigation"
          aria-controls="mobile-navigation"
          aria-expanded="false"
          data-mobile-menu-toggle
        >
          <span class="menu-icon" aria-hidden="true">
            <span class="menu-line menu-line-top"></span>
            <span class="menu-line menu-line-middle"></span>
            <span class="menu-line menu-line-bottom"></span>
          </span>
        </button>

        <div
          class="mobile-nav-panel"
          id="mobile-navigation"
          data-mobile-nav-panel
          hidden
        >
          <nav class="site-shell mobile-nav" aria-label="Mobile navigation">
            {
              navigation.map((item, index) => (
                <a
                  class:list={["mobile-nav-link", item.active && "is-active"]}
                  href={item.href}
                  aria-current={item.active ? "page" : undefined}
                  data-mobile-nav-link
                  data-nav-link
                  data-nav-pathname={item.pathname}
                  data-nav-hash={item.hash}
                >
                  <span class="mobile-nav-index" aria-hidden="true">
                    {String(index + 1).padStart(2, "0")}
                  </span>
                  {item.label}
                </a>
              ))
            }
          </nav>
        </div>
      </div>
    </div>
  </div>
</header>

---
import type { ProjectContentBlock } from "../../schemas/project";
import { responsiveSrcSet } from "../../lib/responsive-images";

interface Props {
  blocks: ProjectContentBlock[];
}

const { blocks } = Astro.props;

const photoRecommendations = {
  cover: "2400 × 1600 px · landscape cover",
  detail: "1800 × 1200 px · landscape detail",
  portrait: "1600 × 2000 px · portrait detail",
  screenshot: "Native resolution · at least 1600 px wide",
  diagram: "SVG preferred · otherwise at least 1800 px wide",
} as const;
---

<div class="project-content">
  {
    blocks.map((block) => {
      switch (block.type) {
        case "paragraph":
          return <p>{block.body}</p>;
        case "heading":
          return block.level === 2 ? (
            <h2>{block.title}</h2>
          ) : (
            <h3>{block.title}</h3>
          );
        case "image":
          return (
            <figure>
              <img
                src={block.src}
                srcset={responsiveSrcSet(block.src)}
                sizes="(max-width: 960px) 100vw, 820px"
                alt={block.alt}
                loading="lazy"
                decoding="async"
              />
              {block.caption && <figcaption>{block.caption}</figcaption>}
            </figure>
          );
        case "gallery":
          return (
            <div class="content-gallery">
              {block.images.map((image) => (
                <figure>
                  <img
                    src={image.src}
                    srcset={responsiveSrcSet(image.src)}
                    sizes="(max-width: 720px) 100vw, (max-width: 960px) 50vw, 400px"
                    alt={image.alt}
                    loading="lazy"
                    decoding="async"
                  />
                  {image.caption && <figcaption>{image.caption}</figcaption>}
                </figure>
              ))}
            </div>
          );
        case "code":
          return (
            <pre>
              <code data-language={block.language}>{block.code}</code>
            </pre>
          );
        case "quote":
          return (
            <blockquote>
              <p>{block.body}</p>
              {block.attribution && <cite>{block.attribution}</cite>}
            </blockquote>
          );
        case "callout":
          return (
            <aside class:list={["content-callout", `callout-${block.style}`]}>
              <strong>{block.title}</strong>
              <p>{block.body}</p>
            </aside>
          );
        case "specificationTable":
          return (
            <div class="spec-table-wrap">
              <table class="spec-table">
                <caption>{block.title}</caption>
                <tbody>
                  {block.rows.map((row) => (
                    <tr>
                      <th scope="row">{row.label}</th>
                      <td>{row.value}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          );
        case "timeline":
          return (
            <section class="content-timeline-section">
              <h2>{block.title}</h2>
              <ol class="content-timeline">
                {block.items.map((item) => (
                  <li>
                    <span
                      class:list={[
                        "timeline-marker",
                        item.state && `is-${item.state}`,
                      ]}
                    />
                    <div>
                      <div class="content-timeline-heading">
                        <strong>{item.title}</strong>
                        {item.date && <span>{item.date}</span>}
                      </div>
                      <p>{item.body}</p>
                    </div>
                  </li>
                ))}
              </ol>
            </section>
          );
        case "linkGroup":
          return (
            <div class="content-links">
              {block.links.map((link) => (
                <a href={link.url} rel="noreferrer">
                  {link.label} <span aria-hidden="true">↗</span>
                </a>
              ))}
            </div>
          );
        case "video":
          return (
            <figure>
              <video controls preload="metadata" poster={block.poster}>
                <source src={block.src} />
              </video>
              {block.caption && <figcaption>{block.caption}</figcaption>}
            </figure>
          );
        case "diagram":
          return (
            <aside class="content-diagram">
              {block.title && <strong>{block.title}</strong>}
              <p>{block.description}</p>
              {block.items?.length && (
                <ul>
                  {block.items.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              )}
            </aside>
          );
        case "photoPlan":
          return (
            <section class="content-photo-plan">
              <h3>{block.title}</h3>
              <div class="photo-plan-grid">
                {block.items.map((item) => (
                  <article
                    class:list={["photo-plan-item", `photo-kind-${item.kind}`]}
                  >
                    <div class="photo-placeholder-frame" aria-hidden="true">
                      <span>Image / to capture</span>
                    </div>
                    <div class="photo-plan-copy">
                      <strong>{item.title}</strong>
                      <p>{item.description}</p>
                      <small>{photoRecommendations[item.kind]}</small>
                    </div>
                  </article>
                ))}
              </div>
            </section>
          );
      }
    })
  }
</div>

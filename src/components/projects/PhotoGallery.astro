---
import { responsiveSrcSet } from "../../lib/responsive-images";

interface Props {
  photos: { label: string; src: string; alt: string; caption?: string }[];
  label: string;
  id: string;
}

const { photos, label, id } = Astro.props;
const [front] = photos;
const sizes = "(max-width: 720px) 100vw, 63vw";
---

{
  front && (
    <figure class="photo-gallery" data-photo-gallery>
      <div class="photo-stage" data-photo-stage>
        <img
          src={front.src}
          srcset={responsiveSrcSet(front.src)}
          sizes={sizes}
          alt={front.alt}
          decoding="async"
          draggable="false"
          fetchpriority="high"
          data-gallery-image
        />
        <button
          class="magnify"
          type="button"
          aria-pressed="false"
          aria-describedby={`${id}-magnify-help`}
          data-gallery-zoom
        >
          Magnify
        </button>
        <span class="sr-only" id={`${id}-magnify-help`}>
          Pan the magnified photo by dragging it or using the arrow keys. Press
          Escape to return to the full photo.
        </span>
      </div>
      <div class="photo-options" role="group" aria-label={label}>
        {photos.map((photo, index) => (
          <button
            type="button"
            aria-pressed={index === 0 ? "true" : "false"}
            data-gallery-source={photo.src}
            data-srcset={responsiveSrcSet(photo.src)}
            data-alt={photo.alt}
            data-caption={photo.caption}
          >
            {photo.label}
          </button>
        ))}
      </div>
      <figcaption class="photo-caption" aria-live="polite" data-gallery-caption>
        {front.caption}
      </figcaption>
    </figure>
  )
}

<script>
  const panDirections: Record<string, [number, number]> = {
    ArrowLeft: [-10, 0],
    ArrowRight: [10, 0],
    ArrowUp: [0, -10],
    ArrowDown: [0, 10],
  };

  for (const gallery of document.querySelectorAll("[data-photo-gallery]")) {
    const stage = gallery.querySelector<HTMLElement>("[data-photo-stage]");
    const image = gallery.querySelector<HTMLImageElement>(
      "[data-gallery-image]",
    );
    const magnify = gallery.querySelector<HTMLButtonElement>(
      "[data-gallery-zoom]",
    );
    const caption = gallery.querySelector("[data-gallery-caption]");
    const choices = gallery.querySelectorAll<HTMLButtonElement>(
      "[data-gallery-source]",
    );
    if (!stage || !image || !magnify || !caption) continue;

    let zoomed = false;
    let x = 50;
    let y = 50;
    const imageSizes = image.sizes;

    const pan = (horizontal: number, vertical: number) => {
      x = Math.max(0, Math.min(100, horizontal));
      y = Math.max(0, Math.min(100, vertical));
      stage.style.setProperty("--photo-x", `${x}%`);
      stage.style.setProperty("--photo-y", `${y}%`);
    };

    const zoom = (active: boolean) => {
      zoomed = active;
      stage.classList.toggle("is-zoomed", active);
      magnify.setAttribute("aria-pressed", String(active));
      image.sizes = active ? "1600px" : imageSizes;
      pan(50, 50);
    };

    const panToPointer = (event: PointerEvent) => {
      const rect = stage.getBoundingClientRect();
      pan(
        ((event.clientX - rect.left) / rect.width) * 100,
        ((event.clientY - rect.top) / rect.height) * 100,
      );
    };

    for (const button of choices) {
      button.addEventListener("click", () => {
        const { gallerySource, srcset, alt, caption: text } = button.dataset;
        if (!gallerySource || alt === undefined) return;

        image.src = gallerySource;
        image.alt = alt;
        if (srcset) image.srcset = srcset;
        else image.removeAttribute("srcset");
        caption.textContent = text ?? "";

        for (const choice of choices) {
          choice.setAttribute("aria-pressed", String(choice === button));
        }
        zoom(false);
      });
    }

    magnify.addEventListener("click", () => zoom(!zoomed));
    magnify.addEventListener("keydown", (event) => {
      if (!zoomed) return;

      if (event.key === "Escape") {
        zoom(false);
        return;
      }

      const offset = panDirections[event.key];
      if (!offset) return;

      event.preventDefault();
      pan(x + offset[0], y + offset[1]);
    });

    stage.addEventListener("pointerdown", (event) => {
      if (!zoomed || event.target === magnify || event.pointerType === "mouse")
        return;
      stage.setPointerCapture(event.pointerId);
      panToPointer(event);
    });
    stage.addEventListener("pointermove", (event) => {
      if (
        zoomed &&
        event.target !== magnify &&
        (event.pointerType === "mouse" ||
          stage.hasPointerCapture(event.pointerId))
      ) {
        panToPointer(event);
      }
    });
  }
</script>

<style>
  .photo-gallery {
    display: grid;
    grid-template-areas: "photo photo" "controls caption";
    grid-template-columns: max-content minmax(0, 1fr);
    grid-template-rows: 1fr auto;
    align-items: center;
    min-width: 0;
    margin: 0;
    border-bottom: 1px solid var(--border-strong);
  }

  .photo-stage {
    position: relative;
    isolation: isolate;
    grid-area: photo;
    align-self: stretch;
    overflow: hidden;
    min-height: clamp(18rem, 31vw, 30rem);
    background: var(--feature-bg);
  }

  .photo-stage img {
    position: absolute;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 60%;
    transform-origin: var(--photo-x, 50%) var(--photo-y, 50%);
    transition: transform 180ms ease-out;
    user-select: none;
    pointer-events: none;
  }

  .photo-stage.is-zoomed {
    cursor: crosshair;
    touch-action: none;
  }

  .photo-stage.is-zoomed img {
    object-position: var(--photo-x, 50%) var(--photo-y, 50%);
    transform: scale(2.05);
  }

  button {
    min-height: 2.75rem;
    cursor: pointer;
  }

  .magnify {
    position: absolute;
    right: 0.75rem;
    bottom: 0.75rem;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--feature-text);
    background: var(--feature-bg);
    color: var(--feature-text);
    font-size: 0.875rem;
  }

  .magnify:hover,
  .magnify[aria-pressed="true"] {
    background: var(--feature-text);
    color: var(--feature-bg);
  }

  .magnify:focus-visible {
    outline-color: var(--feature-text);
    box-shadow: 0 0 0 6px var(--feature-bg);
  }

  .photo-options {
    grid-area: controls;
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    padding-inline: 0.5rem;
  }

  .photo-options button {
    padding: 0.55rem 0.65rem 0.45rem;
    border: 0;
    border-bottom: 2px solid transparent;
    background: transparent;
    color: var(--text-secondary);
    font-size: 0.875rem;
  }

  .photo-options button:hover,
  .photo-options button[aria-pressed="true"] {
    border-bottom-color: var(--primary-strong);
    color: var(--text);
  }

  .photo-options button[aria-pressed="true"] {
    font-weight: 700;
  }

  .photo-caption {
    grid-area: caption;
    max-width: 38ch;
    justify-self: end;
    padding: 0.45rem 0.65rem;
    color: var(--text-secondary);
    text-align: right;
    font: 0.69rem/1.35 var(--font-mono);
  }

  @media (min-width: 721px) and (max-width: 960px), (max-width: 560px) {
    .photo-gallery {
      grid-template-areas: "photo" "controls" "caption";
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: 1fr auto auto;
    }

    .photo-caption {
      max-width: none;
      justify-self: start;
      text-align: left;
    }
  }

  @media (max-width: 720px) {
    .photo-stage {
      min-height: clamp(13.5rem, 52vw, 25rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .photo-stage img {
      transition: none;
    }
  }
</style>

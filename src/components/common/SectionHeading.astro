---
interface Props {
  id?: string;
  eyebrow?: string;
  title: string;
  description?: string;
  align?: "left" | "center";
  as?: "h1" | "h2";
  variant?: "page";
}

const {
  id,
  eyebrow,
  title,
  description,
  align = "left",
  as: Heading = "h2",
  variant,
}: Props = Astro.props;
const accentPeriod = variant === "page" && title.endsWith(".");
---

<div
  class:list={[
    "section-heading",
    align === "center" && "is-centred",
    variant === "page" && "section-heading-page",
  ]}
>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <Heading id={id}>
    {
      accentPeriod ? (
        <>
          {title.slice(0, -1)}
          <span class="heading-period">.</span>
        </>
      ) : (
        title
      )
    }
  </Heading>
  {description && <p class="section-description">{description}</p>}
</div>

<style>
  .section-heading.section-heading-page {
    display: grid;
    max-width: none;
    margin-bottom: 0;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.5fr);
    align-items: end;
    gap: 0.85rem 2rem;
    padding-block: clamp(2.5rem, 6.4vw, 6.2rem) clamp(2rem, 4.2vw, 3.65rem);
  }

  .section-heading-page .eyebrow {
    grid-column: 1 / -1;
  }

  .section-heading-page h1 {
    margin: 0 0 0 -0.045em;
    font-size: clamp(4rem, 10.2vw, 9.5rem);
    font-weight: 700;
    letter-spacing: -0.086em;
    line-height: 0.87;
    overflow-wrap: anywhere;
  }

  .section-heading-page .section-description {
    max-width: 33ch;
    margin: 0;
    color: var(--text);
    font-size: clamp(1.12rem, 1.8vw, 1.55rem);
    letter-spacing: -0.023em;
    line-height: 1.4;
  }

  .heading-period {
    color: var(--primary-strong);
  }

  @media (max-width: 720px) {
    .section-heading.section-heading-page {
      grid-template-columns: 1fr;
      gap: 1.15rem;
      padding-block-start: 1.85rem;
    }

    .section-heading-page h1 {
      font-size: clamp(3.55rem, 12.2vw, 6.3rem);
    }
  }
</style>

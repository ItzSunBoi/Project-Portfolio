---
interface Props {
  size?: number;
  decorative?: boolean;
  class?: string;
}

const { size = 32, decorative = true, class: className } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 64 64"
  role={decorative ? undefined : "img"}
  aria-hidden={decorative ? "true" : undefined}
  aria-label={decorative ? undefined : "ItzSunBoi sun mark"}
>
  <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="5">
    <path d="M32 4v8M32 52v8M4 32h8M52 32h8"></path>
    <path
      d="m12.2 12.2 5.7 5.7M46.1 46.1l5.7 5.7M51.8 12.2l-5.7 5.7M17.9 46.1l-5.7 5.7"
    ></path>
  </g>
  <circle
    cx="32"
    cy="32"
    r="14"
    fill="currentColor"
    stroke="var(--sun-shadow)"
    stroke-width="2"></circle>
</svg>

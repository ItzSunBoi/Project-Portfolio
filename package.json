{
  "name": "itzsunboi-portfolio",
  "version": "1.3.0",
  "private": true,
  "description": "My modular hardware, firmware and software project portfolio.",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "npm ci",
    "dev": "astro dev",
    "build": "bash scripts/build-verified.sh",
    "build:astro": "astro build",
    "preview": "astro preview",
    "check": "npm run validate:content && astro check",
    "validate:content": "node --import tsx scripts/validate-content.ts",
    "test": "vitest run",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.3",
    "astro": "7.1.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@tailwindcss/vite": "4.2.1",
    "@types/node": "22.19.19",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-astro": "1.6.0",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "tailwindcss": "4.2.1",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "displayName": "ItzSunBoi Project Portfolio"
}
